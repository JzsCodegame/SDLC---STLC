cd /d "%~dp0"
set "ACADEMY_SETUP_ROOT=%~dp0"
set "ACADEMY_SETUP_ARGS=%*"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { Import-Module Microsoft.PowerShell.Utility -ErrorAction Stop; $root=$env:ACADEMY_SETUP_ROOT; $file=Join-Path $root 'WindowsBootstrap.ps1'; $manifest=Get-Content -LiteralPath (Join-Path $root 'kit-manifest.json') -Raw | ConvertFrom-Json; $entry=@($manifest.files | Where-Object { $_.path -eq 'WindowsBootstrap.ps1' }); if ($manifest.schemaVersion -ne 1 -or $entry.Count -ne 1) { throw 'Bootstrap manifest entry is missing or duplicated. Extract the complete ZIP again.' }; $item=Get-Item -LiteralPath $file; if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $item.Length -ne $entry[0].bytes -or (Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash -ne $entry[0].sha256) { throw 'Bootstrap verification failed. Extract the complete ZIP again.' }; . ([ScriptBlock]::Create((Get-Content -LiteralPath $file -Raw))); Invoke-AcademyBootstrap; exit 0 } catch { Write-Host ('SETUP STOPPED: '+$_.Exception.Message); Write-Host 'Your work is preserved. If this computer blocks installation, ask its administrator; do not change execution policy.'; exit 1 }"
