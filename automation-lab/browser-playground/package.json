{
  "name": "academy-browser-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 53220 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": { "@vitejs/plugin-react": "6.1.1", "vite": "8.3.2", "@playwright/test": "1.63.0", "typescript": "7.0.2", "@types/react": "19.3.0", "@types/react-dom": "19.3.0" }
}
