# Copy to .env on a dedicated Linux control-plane host. Do not commit .env.
LAB_DOMAIN=lab.example.org
# 32+ random alphanumeric characters. URL characters must be percent encoded.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_32_PLUS
# Token stays in trusted control-plane services: Coder and optional Caddy DNS TLS.
DIGITALOCEAN_TOKEN=REPLACE_WITH_SCOPED_DO_TOKEN
